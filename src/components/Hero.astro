---
import { site } from '../data/site';

const lines = [
  { cmd: 'whoami', out: site.name },
  { cmd: 'cat papel.txt', out: site.role },
  { cmd: 'ls ./stack', out: 'laravel  vue  spring-boot  postgres  docker' },
  { cmd: 'echo $FOCO', out: 'produtos com IA (Spring AI, LLMs)' },
];
---

<section class="hero">
  <div class="glow" aria-hidden="true"></div>
  <div class="container grid">
    <div class="copy">
      <p class="hello mono">Olá, eu sou</p>
      <h1>{site.name}</h1>
      <p class="role">
        <span class="gradient-text">{site.role}</span> · Laravel · Vue · Spring Boot · IA
      </p>
      <p class="tagline">{site.tagline}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#projetos">Ver projetos</a>
        <a class="btn" href="#contato">Falar comigo</a>
      </div>
    </div>

    <div class="terminal" role="img" aria-label="Terminal com informações sobre Assis">
      <div class="bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p class="mono">zsh · ~/assis-freitas</p>
      </div>
      <div class="body mono" aria-hidden="true">
        {
          lines.map((l, i) => (
            <div class="line" style={`--d:${i * 0.7}s`}>
              <p>
                <span class="prompt">$</span> {l.cmd}
              </p>
              <p class="out">{l.out}</p>
            </div>
          ))
        }
        <p class="line" style={`--d:${lines.length * 0.7}s`}>
          <span class="prompt">$</span> <span class="cursor"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 112px 0 96px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    pointer-events: none;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(to bottom, #000 30%, transparent);
    opacity: 0.6;
    pointer-events: none;
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hello {
    color: var(--a1);
    margin: 0 0 6px;
    font-size: 15px;
  }
  h1 {
    font-size: clamp(42px, 6.5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 14px;
    font-weight: 800;
  }
  .role {
    font-size: 19px;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 20px;
  }
  .tagline {
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 32px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .terminal {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--panel);
    box-shadow: var(--shadow);
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--border);
  }
  .bar p {
    margin: 0 auto;
    padding-right: 40px;
    font-size: 12px;
    color: var(--muted);
  }
  .body {
    padding: 20px 22px 24px;
    font-size: 14px;
    line-height: 1.7;
  }
  .body p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .line {
    opacity: 0;
    animation: show 0.35s ease forwards;
    animation-delay: var(--d);
    margin-bottom: 8px;
  }
  .prompt {
    color: var(--a1);
  }
  .out {
    color: var(--muted);
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 17px;
    vertical-align: -3px;
    background: var(--a1);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes show {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      opacity: 1;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding: 64px 0 72px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
