---
import { site } from '../data/site';
import { content, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}
const t = content[Astro.props.lang].hero;

const lines = [
  { cmd: 'whoami', out: site.name },
  { cmd: 'cat role.txt', out: t.terminal.role },
  { cmd: 'ls ./stack', out: 'java  spring-boot  php  laravel  vue  angular' },
  { cmd: 'echo $FOCUS', out: t.terminal.focus },
];
const [before, em, after] = t.headline.split('*');
---

<section class="hero">
  <div class="container grid">
    <div class="copy">
      <p class="hello mono" data-reveal>{t.hello}</p>
      <h1 data-reveal style="--i:1">
        {before}<em>{em}</em>{after}<span class="accent">.</span>
      </h1>
      <p class="tagline" data-reveal style="--i:2">{t.tagline}</p>
      <div class="actions" data-reveal style="--i:3">
        <a class="btn btn-primary" href="#projects">{t.ctaProjects}</a>
        <a class="btn" href="#contact">{t.ctaContact}</a>
      </div>
    </div>

    <div class="terminal" role="img" aria-label={content[Astro.props.lang].ui.terminalLabel} data-reveal style="--i:2">
      <div class="bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p class="mono">~/assis-freitas</p>
      </div>
      <div class="body mono" aria-hidden="true">
        {
          lines.map((l, i) => (
            <div class="line" style={`--d:${0.6 + i * 0.6}s`}>
              <p>
                <span class="prompt">$</span> {l.cmd}
              </p>
              <p class="out">{l.out}</p>
            </div>
          ))
        }
        <p class="line" style={`--d:${0.6 + lines.length * 0.6}s`}>
          <span class="prompt">$</span> <span class="cursor"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 120px 0 104px;
    border-bottom: 1px solid var(--border);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 64px;
    align-items: end;
  }
  .hello {
    color: var(--accent);
    margin: 0 0 18px;
    font-size: 14px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 26px;
  }
  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }
  .tagline {
    color: var(--muted);
    max-width: 50ch;
    margin: 0 0 34px;
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .terminal {
    border: 1px solid var(--fg);
    border-radius: 10px;
    background: var(--panel);
    box-shadow: 6px 6px 0 var(--fg);
    overflow: hidden;
    min-width: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--fg);
    background: var(--bg-soft);
  }
  .bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid var(--fg);
  }
  .bar span:first-child {
    background: var(--accent);
    border-color: var(--accent);
  }
  .bar p {
    margin: 0 0 0 auto;
    font-size: 12px;
    color: var(--muted);
  }
  .body {
    padding: 20px 22px 22px;
    font-size: 14px;
    line-height: 1.7;
    min-height: 268px;
  }
  .body p {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .line {
    opacity: 0;
    animation: show 0.35s ease forwards;
    animation-delay: var(--d);
    margin-bottom: 8px;
  }
  .prompt {
    color: var(--accent);
  }
  .out {
    color: var(--muted);
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 17px;
    vertical-align: -3px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes show {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .line {
      opacity: 1;
    }
  }
  @media (max-width: 860px) {
    .hero {
      padding: 64px 0 72px;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .terminal {
      margin-right: 6px;
    }
  }
</style>
