---
import Logo from './Logo.astro';
import { content, langMeta, langs, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
  /** false na página 404: só mostra logo, tema e idioma. */
  showNav?: boolean;
}
const { lang = 'pt', showNav = true } = Astro.props;
const t = content[lang];
const home = langMeta[lang].path;

const nav = [
  { href: '#about', label: t.nav.about },
  { href: '#stack', label: t.nav.stack },
  { href: '#projects', label: t.nav.projects },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="header">
  <div class="container inner">
    <a href={home} class="logo" aria-label={t.ui.home}>
      <Logo size={30} />
      <span class="word">assis<span class="accent">.</span>freitas</span>
    </a>
    {
      showNav && (
        <nav aria-label={t.ui.sections}>
          {nav.map((n) => (
            <a href={n.href} class="mono">
              {n.label}
            </a>
          ))}
        </nav>
      )
    }
    <ul class="langs mono" aria-label={t.ui.language}>
      {
        langs.map((l) => (
          <li>
            <a
              href={langMeta[l].path}
              hreflang={langMeta[l].htmlLang}
              lang={langMeta[l].htmlLang}
              title={langMeta[l].name}
              aria-current={l === lang ? 'true' : undefined}
              data-lang={l}
            >
              {langMeta[l].label}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="theme" type="button" aria-label={t.ui.toggleTheme} title={t.ui.toggleTheme}>
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21 14.5A8.5 8.5 0 0 1 9.5 3a8.5 8.5 0 1 0 11.5 11.5Z"/></svg>
    </button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  document.querySelectorAll<HTMLAnchorElement>('.langs a').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', a.dataset.lang ?? '');
      } catch {}
    }),
  );
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: auto;
  }
  .word {
    font-family: var(--display);
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    gap: 22px;
  }
  nav a {
    white-space: nowrap;
    font-size: 14px;
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--fg);
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 2px;
    font-size: 12px;
  }
  .langs a {
    display: block;
    padding: 4px 7px;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
  }
  .langs a:hover {
    color: var(--fg);
  }
  .langs a[aria-current] {
    color: var(--on-accent);
    background: var(--accent);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--fg);
    cursor: pointer;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 820px) {
    nav {
      display: none;
    }
  }
</style>
