---
import { about, stack, summary, timeline } from '../data/site';
---

<section id="sobre" class="section">
  <div class="container">
    <p class="section-label" data-reveal>sobre</p>
    <div class="layout">
      <div>
        <p class="summary" data-reveal style="--i:1">{summary}</p>
        <div class="about">
          {about.map((p, i) => <p data-reveal style={`--i:${i + 2}`}>{p}</p>)}
        </div>
      </div>
      <ol class="timeline" aria-label="Linha do tempo">
        {
          timeline.map((t, i) => (
            <li data-reveal style={`--i:${i + 1}`}>
              <span class="year mono">{t.year}</span>
              <span>{t.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<section id="stack" class="section alt">
  <div class="container">
    <p class="section-label" data-reveal>stack</p>
    <h2 class="section-title" data-reveal style="--i:1">Ferramentas do dia a dia</h2>
    <div class="groups">
      {
        stack.map((g, gi) => (
          <div class="group" data-reveal style={`--i:${gi}`}>
            <h3 class="mono">{g.title}</h3>
            <ul>
              {g.items.map((it) => (
                <li style={`--brand:#${it.icon.hex}`}>
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                    <path d={it.icon.path} />
                  </svg>
                  {it.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 72px;
    align-items: start;
  }
  .summary {
    font-family: var(--display);
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 32px;
  }
  .about {
    max-width: 62ch;
    color: var(--muted);
  }
  .about p {
    margin: 0 0 16px;
  }
  .timeline {
    list-style: none;
    margin: 6px 0 0;
    padding: 0 0 0 22px;
    border-left: 1px solid var(--border);
  }
  .timeline li {
    position: relative;
    display: grid;
    gap: 2px;
    padding-bottom: 26px;
    color: var(--muted);
    font-size: 15.5px;
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .timeline li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 7px;
    width: 9px;
    height: 9px;
    background: var(--bg);
    border: 1px solid var(--fg);
  }
  .timeline li:last-child::before {
    background: var(--accent);
    border-color: var(--accent);
  }
  .year {
    color: var(--fg);
    font-weight: 600;
    font-size: 14px;
  }

  .alt {
    background: var(--bg-soft);
    border-block: 1px solid var(--border);
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .group {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--panel);
    padding: 22px;
  }
  h3 {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .group li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
  }
  .group li svg {
    padding: 7px;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--chip);
    fill: var(--fg);
    transition: fill 0.2s ease;
  }
  .group li:hover svg {
    fill: var(--brand);
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
