---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site } from '../data/site';
import { content, langMeta, langs, type Lang } from '../data/i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  alternates?: boolean;
}

const { lang = 'pt', alternates = true } = Astro.props;
const t = content[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={langMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates &&
        langs.map((l) => (
          <link rel="alternate" hreflang={langMeta[l].htmlLang} href={new URL(langMeta[l].path, site.url).href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL('/', site.url).href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={langMeta[lang].ogLocale} />
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        // Só redireciona quem já escolheu um idioma no seletor (nunca pelo idioma do navegador,
        // para não atrapalhar buscadores).
        const l = localStorage.getItem('lang');
        const paths = { en: '/en/', es: '/es/' };
        if (location.pathname === '/' && paths[l]) location.replace(paths[l]);
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
